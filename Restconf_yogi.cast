[1735.374797, "o", "ort_keys=\u001b[1m\u001b[96mTrue\u001b[m, indent=\u001b[95m4\u001b[m )\r\n \u001b[93melse\u001b[m:\r\n  logging.error(f\u001b[95m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\r\n  \u001b[93mreturn\u001b[m response.text\r\n\u001b[1m\u001b[96mprint\u001b[m (get_interfaces(\u001b[95m\"interfaces/interface/\"\u001b[m, \u001b[95m\"GigabitEthernet1?verbose\"\u001b[m))i\r\n\u001b[94m~                                                                                                                                                                                                                \u001b[25;1H~                                                                                                                                                                                                                \u001b[26;1H~                                                                                                                                                                                                                "]
