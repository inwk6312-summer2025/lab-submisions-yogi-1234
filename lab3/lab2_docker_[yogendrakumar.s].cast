[6122.022615, "o", "\u001b[?25l yaml\r\n\u001b[96m# Declare \u001b[m\u001b[4;11H\u001b[K\u001b[4;11H\u001b[?25h"]
[6122.027647, "o", "\u001b[?25l\u001b[96mtemplate environment\u001b[m\r\nENV = Environment(loader=FileSy\u001b[5;32H\u001b[K\u001b[5;32H\u001b[?25h"]
[6122.028574, "o", "\u001b[?25lstemLoader(\u001b[95m'.'\u001b[m))\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_int\u001b[m\u001b[6;12H\u001b[K\u001b[6;12H\u001b[?25h"]
[6122.03396, "o", "\u001b[?25l\u001b[1m\u001b[96merface_speed\u001b[m(\u001b[1m\u001b[96mint\u001b[?25h\u001b[?25l\u001b[m\b\b\binterface_name):\r\n\u001b[95m\"\"\" get_interface_speed returns the default Mbps\u001b[m\u001b[7;49H\u001b[K\u001b[7;49H\u001b[?25h"]
[6122.035006, "o", "\u001b[?25l\u001b[95m value for a given\r\nnetwork interface by looking for certain ke\u001b[m\u001b[8;44H\u001b[K\u001b[8;44H\u001b[?25h"]
[6122.035796, "o", "\u001b[?25l\u001b[95mywords in the name\r\n\"\"\"\u001b[m\u001b[9;4H\u001b[K\u001b[10;1H\u001b[93mif\u001b[m \u001b[95m'gigabit'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[10;40H\u001b[K\u001b[10;40H\u001b[?25h"]
[6122.039872, "o", "\u001b[?25l\r\n\u001b[93mreturn\u001b[m \u001b[95m1000\u001b[m\u001b[11;12H\u001b[K\u001b[12;1H\u001b[93mif\u001b[m \u001b[95m'fast'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[12;37H\u001b[K\u001b[13;1H\u001b[93mreturn\u001b[m \u001b[95m100\u001b[m\u001b[13;11H\u001b[K\u001b[14;1H\u001b[96m# \u001b[m\u001b[14;3H\u001b[K\u001b[14;3H\u001b[?25h"]
[6122.041501, "o", "\u001b[?25l\u001b[96mFilters are added to the ENV object after declaration. Note tha\u001b[?25h"]
[6122.042952, "o", "\u001b[?25lt we're\r\n# actually passing in our \"get_interface_speed\" functio\u001b[m\u001b[15;56H\u001b[K\u001b[15;56H\u001b[?25h"]
[6122.047613, "o", "\u001b[?25l\u001b[96mn and not running\r\n# it--the template engine will execute this f\u001b[m\u001b[16;46H\u001b[K\u001b[16;46H\u001b[?25h"]
[6122.048623, "o", "\u001b[?25l\u001b[96munction when we call\r\n# template.render()\u001b[m\u001b[17;20H\u001b[K\u001b[18;1HENV.filters[\u001b[95m'get_inter\u001b[m\u001b[18;23H\u001b[K\u001b[18;23H\u001b[?25h"]
[6122.049596, "o", "\u001b[?25l\u001b[95mface_speed'\u001b[m] = get_interface_speed\r\ntemplate = ENV.get_template(\u001b[19;29H\u001b[K\u001b[19;29H\u001b[?25h"]
[6122.053713, "o", "\u001b[?25l\u001b[95m\"template-task8.j2\"\u001b[m)\r\n\u001b[96m# We load our YAML file and pass it in to \u001b[m\u001b[20;43H\u001b[K\u001b[20;43H\u001b[?25h"]
[6122.054581, "o", "\u001b[?25l\u001b[96mthe template when rendering it.\u001b[m\r\n\u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"data-task7.yml\"\u001b[m) \u001b[93mas\u001b[m \u001b[21;32H\u001b[K\u001b[21;32H\u001b[?25h"]
[6122.055482, "o", "\u001b[?25lf:\r\ninterfaces = yaml.load(f, Loader=yaml.SafeLoader)\u001b[22;50H\u001b[K\u001b[23;1H\u001b[1m\u001b[96mprint\u001b[m(temp\u001b[23;11H\u001b[K\u001b[23;11H\u001b[?25h"]
